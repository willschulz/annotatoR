[Unit]
Description=annotatoR Shiny service for Cloudflare Access
After=network.target

[Service]
Type=simple
WorkingDirectory=/tmp
Environment=ANNOTATOR_DB=/home/wschulz/projects/tools/annotatoR/state/annotatoR.sqlite
Environment=ANNOTATOR_CF_ACCESS_ENABLED=true
EnvironmentFile=%h/.config/annotator/cloudflare-access.env
ExecStart=/usr/bin/Rscript -e "library(annotatoR); annotator_run_app(port = 3841L, host = '127.0.0.1')"
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
KillMode=control-group
StandardOutput=append:/home/wschulz/projects/tools/annotatoR/state/logs/annotator-cloudflare.log
StandardError=append:/home/wschulz/projects/tools/annotatoR/state/logs/annotator-cloudflare.log

[Install]
WantedBy=multi-user.target
