[Unit]
Description=Cloudflare Tunnel for public annotatoR access
After=network-online.target annotator-cloudflare.service
Wants=network-online.target
Requires=annotator-cloudflare.service

[Service]
Type=notify
User=cloudflared
ExecStart=/usr/bin/cloudflared --no-autoupdate --config /etc/cloudflared-annotator/config.yml tunnel run
Restart=on-failure
RestartSec=5s
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
